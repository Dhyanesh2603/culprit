{
  "name": "who-broke-the-build-backend",
  "version": "1.0.0",
  "description": "Backend API and Realtime Service for Who Broke The Build",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/prepare-prisma.js && rimraf dist && tsc",
    "start": "node dist/server.js",
    "start:railway": "node scripts/prepare-prisma.js && npx prisma db push --schema=prisma/schema.postgresql.prisma && tsx prisma/seed.ts && node dist/server.js",
    "prisma:generate": "node scripts/prepare-prisma.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
